[Unit]
Description=YouTube Remote Controller Server
After=network.target sound.target pipewire.service
Wants=pipewire.service

[Service]
Type=simple
WorkingDirectory=/home/ajsec/youtube-remote/server
Environment=NODE_ENV=production
Environment=DISPLAY=:0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/bin/node /home/ajsec/youtube-remote/server/dist/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
