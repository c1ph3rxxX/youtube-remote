{
  "name": "youtube-remote-server",
  "version": "1.0.0",
  "description": "Self-hosted YouTube remote control server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "jest"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "@fastify/websocket": "^8.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "@fastify/multipart": "^8.3.0",
    "playwright": "^1.48.2",
    "better-sqlite3": "^11.3.0",
    "ws": "^8.18.0",
    "nanoid": "^3.3.7",
    "pino": "^9.4.0",
    "pino-pretty": "^11.3.0",
    "dotenv": "^16.4.5",
    "youtubei.js": "^10.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/better-sqlite3": "^7.6.11",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.2",
    "ts-node-dev": "^2.0.0",
    "ts-node": "^10.9.2",
    "eslint": "^9.11.1",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.13",
    "ts-jest": "^29.2.5"
  }
}
